{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(css|js|img|images)/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/static/$1/$2"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/static/index.html"
    },
    {
      "src": "/index.html",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/static/index.html"
    },
    {
      "src": "/api/categories",
      "headers": {
        "Cache-Control": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/api/index.py"
    },
    {
      "src": "/api/amaliy/modules",
      "headers": {
        "Cache-Control": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
      },
      "dest": "/api/index.py"
    },
    {
      "src": "/admin/?$",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "/static/admin/index.html"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/static/admin/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
